# Required to persist quote submissions through /api/quote
NEXT_PUBLIC_CONVEX_URL=
CONVEX_QUOTE_WRITE_KEY=

# Enable only after the compatible CRM discussion receiver is deployed and tested.
# Server-only; unset/false preserves the current estimate flow.
QUOTE_DISCUSSIONS_ENABLED=false

# Optional public override. Leave unset to use this app's committed public DSN;
# set an empty value to disable Sentry event delivery for an environment.
# Sentry only reports from production builds; `pnpm dev` never sends events.
# NEXT_PUBLIC_SENTRY_DSN=
# Build-only secret for source maps and releases. Configure in Vercel only.
# SENTRY_AUTH_TOKEN=
# Optional during the compatible key-split rollout. When set, Shed Convex
# pricing reads prefer this dedicated server-only key over the write key.
# CONVEX_QUOTE_PRICING_READ_KEY=

# Required server-only CRM deployment for published project reads. The same
# exact deployment is used when CRM quote pricing is enabled.
FRONTIER_PIXEL_CRM_CONVEX_URL=https://youthful-horse-290.convex.cloud
# Leave false throughout the V3 -> V2 -> V1 compatibility rollout. Set true
# only after every published CRM image has derivatives; this disables legacy
# API fallback and caps Next Image source responses at 3 MB.
CRM_PROJECT_IMAGES_V3_REQUIRED=false

# Dedicated server-only callback secret, at least 32 random characters. Match
# SHED210_SITE_REVALIDATION_SECRET in the CRM Convex deployment. Never reuse
# quote/intake credentials. Leave unset until the receiver is ready to activate.
# SHED210_SITE_REVALIDATION_SECRET=

# Quote pricing source. Production requires an explicit value and should switch
# to frontier_pixel_crm only after a reviewed CRM publication exists.
QUOTE_PRICING_SOURCE=shed_convex
# Dedicated CRM SHED_QUOTE_PRICING_READ_KEY; do not reuse a quote write key.
# FRONTIER_PIXEL_CRM_QUOTE_PRICING_KEY=

# Optional tenant selector for /api/quote intake. Defaults to shed210.
# Only set this when the deployment serves a different tenant's storefront.
# QUOTE_TENANT_SLUG=

# Optional public app configuration
NEXT_PUBLIC_SITE_URL=
# Website chat (Autopilot). The CRM Convex *site* origin that serves
# /api/web-chat/*; must be https://<deployment>.convex.site. Leave unset to keep
# chat off (the phone bar keeps its Text button). The CRM must also list this
# site's domain in tenantDomains and have "Answer website chat" switched on.
# NEXT_PUBLIC_CRM_CHAT_URL=https://youthful-horse-290.convex.site
# Cloudflare Turnstile site key for the invisible check when a chat starts
# and when a quote is submitted.
# Pair with WEB_CHAT_TURNSTILE_SECRET_KEY in the CRM Convex deployment (chat)
# and TURNSTILE_SECRET_KEY below (quotes).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The same Turnstile widget's secret key, server only. With it /api/quote asks
# Cloudflare about each quote's token; a quote that doesn't pass is still
# saved, within a small daily allowance (docs/quotes-table.md, "Bot check on
# submit"). Unset, quotes are not checked. Use Cloudflare's test keys locally.
# TURNSTILE_SECRET_KEY=
# Website activity forwarding. Use the existing Shed210 tenant intake credential,
# server-only, never NEXT_PUBLIC. Leave unset to disable this measurement proxy.
# FRONTIER_PIXEL_CRM_WEBSITE_EVENTS_KEY=
# Optional isolated CRM preview endpoint; production defaults to youthful-horse-290.
# FRONTIER_PIXEL_CRM_WEBSITE_EVENTS_URL=https://youthful-horse-290.convex.site/api/intake/marketing-event
# Server-only key for live reviews and the deferred homepage rating summary.
# Restrict it to Places API (New). Google review data is always requested no-store.
GOOGLE_PLACES_API_KEY=
# Optional paired overrides for the decorative hero loop.
NEXT_PUBLIC_HERO_VIDEO_WEBM_SRC=
NEXT_PUBLIC_HERO_VIDEO_MP4_SRC=
# Optional MP4 URL for the click-open full build video.
NEXT_PUBLIC_HERO_FULL_VIDEO_SRC=
# Legacy single-source override; prefer the paired variables above.
NEXT_PUBLIC_HERO_VIDEO_SRC=

# Quote access and alert SMS secrets are configured in Convex:
# CONVEX_QUOTE_WRITE_KEY
# Optional only while rotating the write credential; remove after Vercel uses
# the new current key.
# CONVEX_QUOTE_WRITE_KEY_PREVIOUS=
# Dedicated Shed pricing read credential. During rollout the Convex query also
# accepts the write key unless the fallback flag is explicitly false.
# CONVEX_QUOTE_PRICING_READ_KEY=
# CONVEX_QUOTE_PRICING_READ_KEY_PREVIOUS=
# CONVEX_PRICING_ALLOW_WRITE_KEY_FALLBACK=true
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER

# Quote alert email and CRM handoff secrets are configured in Convex:
# FRONTIER_PIXEL_CRM_ADMIN_URL
# ZOHO_CLIENT_ID
# ZOHO_CLIENT_SECRET
# ZOHO_REFRESH_TOKEN
# ZOHO_MAIL_ACCOUNT_ID
# ZOHO_FROM_ADDRESS
# Optional comma-separated quote alert recipients.
# QUOTE_NOTIFICATION_EMAIL_RECIPIENTS=alerts@example.com

# Optional asynchronous CRM quote intake is configured in Convex, not Vercel.
# It is disabled unless the kill switch is explicitly true.
# SHED_CRM_SYNC_ENABLED=false
# SHED_CRM_BACKFILL_ENABLED=false
# Enable only after the CRM receiver echoes externalSubmissionId,
# sourceDocumentId, and publicId in successful acknowledgements.
# SHED_CRM_REQUIRE_BOUND_ACKNOWLEDGEMENT=false
# FRONTIER_PIXEL_CRM_INTAKE_URL=https://youthful-horse-290.convex.site/api/intake/shed-quote
# FRONTIER_PIXEL_CRM_INTAKE_KEY=

# Optional destructive retention policy in Convex. Unset means disabled. Review
# docs/legacy-convex-data-retirement.md before setting a value from 30-3650.
# QUOTE_DATA_RETENTION_DAYS=

# Vercel Preview deploys should set CONVEX_DEPLOY_KEY in Vercel, not here.
# Use a Convex Preview Deploy Key for the Vercel Preview environment so PR
# previews create temporary Convex preview deployments.
